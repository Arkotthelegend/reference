[
  {
    "type": "math_show",
    "q": "Given \\( z = -\\sqrt{3} + i \\), find \\( z^6 \\) in the form \\( x + yi \\).",
    "c": "<strong>Solution</strong><br><br>Write \\( z = (-\\sqrt{3},\\, 1) \\).<br><div style=\"overflow-x:auto;\">\\[r=\\sqrt{3+1}=2\\]</div><br><div style=\"overflow-x:auto;\">\\[\\cos\\theta=-\\dfrac{\\sqrt{3}}{2},\\quad\\sin\\theta=\\dfrac12\\implies\\theta=\\dfrac{5\\pi}{6}\\]</div><br><div style=\"overflow-x:auto;\">\\[z=2\\left(\\cos\\dfrac{5\\pi}{6}+i\\sin\\dfrac{5\\pi}{6}\\right)\\]</div><br>By De Moivre's theorem,<br><div style=\"overflow-x:auto;\">\\[\\begin{aligned}z^6&=2^6\\left(\\cos 5\\pi+i\\sin 5\\pi\\right)\\\\&=64(-1+0i)=-64.\\end{aligned}\\]</div><br><br><div style=\"display:inline-block;border:2px solid #00D5FF;padding:8px 14px;border-radius:8px;\"><strong>Answer</strong> &nbsp; \\( -64 \\)</div>"
  },
  {
    "type": "math_show",
    "q": "Given \\( z = 1 + \\sqrt{3}\\, i \\), find \\( z^4 \\) in the form \\( x + yi \\).",
    "c": "<strong>Solution</strong><br><br><div style=\"overflow-x:auto;\">\\[r=\\sqrt{1+3}=2\\]</div><br><div style=\"overflow-x:auto;\">\\[\\cos\\theta=\\dfrac12,\\quad\\sin\\theta=\\dfrac{\\sqrt{3}}{2}\\implies\\theta=\\dfrac{\\pi}{3}\\]</div><br><div style=\"overflow-x:auto;\">\\[z=2\\left(\\cos\\dfrac{\\pi}{3}+i\\sin\\dfrac{\\pi}{3}\\right)\\]</div><br><div style=\"overflow-x:auto;\">\\[\\begin{aligned}z^4&=2^4\\left(\\cos\\dfrac{4\\pi}{3}+i\\sin\\dfrac{4\\pi}{3}\\right)\\\\&=16\\left(-\\dfrac12-\\dfrac{\\sqrt{3}}{2}i\\right)\\\\&=-8-8\\sqrt{3}\\, i.\\end{aligned}\\]</div><br><br><div style=\"display:inline-block;border:2px solid #00D5FF;padding:8px 14px;border-radius:8px;\"><strong>Answer</strong> &nbsp; \\( -8-8\\sqrt{3}\\, i \\)</div>"
  },
  {
    "type": "math_show",
    "q": "Given \\( z = -1 - i \\), find \\( z^5 \\) in the form \\( x + yi \\).",
    "c": "<strong>Solution</strong><br><br><div style=\"overflow-x:auto;\">\\[r=\\sqrt{1+1}=\\sqrt{2}\\]</div><br><div style=\"overflow-x:auto;\">\\[\\cos\\theta=-\\dfrac{1}{\\sqrt{2}},\\quad\\sin\\theta=-\\dfrac{1}{\\sqrt{2}}\\implies\\theta=-\\dfrac{3\\pi}{4}\\]</div><br><div style=\"overflow-x:auto;\">\\[z=\\sqrt{2}\\left(\\cos\\left(-\\dfrac{3\\pi}{4}\\right)+i\\sin\\left(-\\dfrac{3\\pi}{4}\\right)\\right)\\]</div><br><div style=\"overflow-x:auto;\">\\[\\begin{aligned}z^5&=(\\sqrt{2})^5\\left(\\cos\\left(-\\dfrac{15\\pi}{4}\\right)+i\\sin\\left(-\\dfrac{15\\pi}{4}\\right)\\right)\\\\&=4\\sqrt{2}\\left(\\cos\\dfrac{\\pi}{4}+i\\sin\\dfrac{\\pi}{4}\\right)\\\\&=4\\sqrt{2}\\left(\\dfrac{\\sqrt{2}}{2}+\\dfrac{\\sqrt{2}}{2}i\\right)=4+4i.\\end{aligned}\\]</div><br>Here \\( -\\dfrac{15\\pi}{4}+4\\pi=\\dfrac{\\pi}{4} \\).<br><br><div style=\"display:inline-block;border:2px solid #00D5FF;padding:8px 14px;border-radius:8px;\"><strong>Answer</strong> &nbsp; \\( 4+4i \\)</div>"
  },
  {
    "type": "math_show",
    "q": "Given \\( z = 2 - 2i \\), find \\( z^3 \\) in the form \\( x + yi \\).",
    "c": "<strong>Solution</strong><br><br><div style=\"overflow-x:auto;\">\\[r=\\sqrt{4+4}=2\\sqrt{2}\\]</div><br><div style=\"overflow-x:auto;\">\\[\\cos\\theta=\\dfrac{1}{\\sqrt{2}},\\quad\\sin\\theta=-\\dfrac{1}{\\sqrt{2}}\\implies\\theta=-\\dfrac{\\pi}{4}\\]</div><br><div style=\"overflow-x:auto;\">\\[z=2\\sqrt{2}\\left(\\cos\\left(-\\dfrac{\\pi}{4}\\right)+i\\sin\\left(-\\dfrac{\\pi}{4}\\right)\\right)\\]</div><br><div style=\"overflow-x:auto;\">\\[\\begin{aligned}z^3&=(2\\sqrt{2})^3\\left(\\cos\\left(-\\dfrac{3\\pi}{4}\\right)+i\\sin\\left(-\\dfrac{3\\pi}{4}\\right)\\right)\\\\&=16\\sqrt{2}\\left(-\\dfrac{\\sqrt{2}}{2}-\\dfrac{\\sqrt{2}}{2}i\\right)\\\\&=-16-16i.\\end{aligned}\\]</div><br><br><div style=\"display:inline-block;border:2px solid #00D5FF;padding:8px 14px;border-radius:8px;\"><strong>Answer</strong> &nbsp; \\( -16-16i \\)</div>"
  },
  {
    "type": "math_show",
    "q": "Given \\( z = \\sqrt{3} + i \\), find \\( z^3 \\) in the form \\( x + yi \\).",
    "c": "<strong>Solution</strong><br><br><div style=\"overflow-x:auto;\">\\[r=\\sqrt{3+1}=2\\]</div><br><div style=\"overflow-x:auto;\">\\[\\cos\\theta=\\dfrac{\\sqrt{3}}{2},\\quad\\sin\\theta=\\dfrac12\\implies\\theta=\\dfrac{\\pi}{6}\\]</div><br><div style=\"overflow-x:auto;\">\\[z=2\\left(\\cos\\dfrac{\\pi}{6}+i\\sin\\dfrac{\\pi}{6}\\right)\\]</div><br><div style=\"overflow-x:auto;\">\\[\\begin{aligned}z^3&=8\\left(\\cos\\dfrac{\\pi}{2}+i\\sin\\dfrac{\\pi}{2}\\right)=8i.\\end{aligned}\\]</div><br><br><div style=\"display:inline-block;border:2px solid #00D5FF;padding:8px 14px;border-radius:8px;\"><strong>Answer</strong> &nbsp; \\( 8i \\)</div>"
  },
  {
    "type": "math_show",
    "q": "Let \\( z_1 = 4 - i \\) and \\( z_2 = 2 + 3i \\). Find \\( z_1 z_2 \\) in the form \\( x + yi \\).",
    "c": "<strong>Solution</strong><br><br><div style=\"overflow-x:auto;\">\\[\\begin{aligned}z_1 z_2&=(4-i)(2+3i)\\\\&=8+12i-2i-3i^2\\\\&=8+10i+3=11+10i.\\end{aligned}\\]</div><br><br><div style=\"display:inline-block;border:2px solid #00D5FF;padding:8px 14px;border-radius:8px;\"><strong>Answer</strong> &nbsp; \\( 11+10i \\)</div>"
  },
  {
    "type": "math_show",
    "q": "Let \\( z_1 = -2 + 5i \\) and \\( z_2 = 1 + i \\). Find \\( z_1 z_2 \\) in the form \\( x + yi \\).",
    "c": "<strong>Solution</strong><br><br><div style=\"overflow-x:auto;\">\\[\\begin{aligned}z_1 z_2&=(-2+5i)(1+i)\\\\&=-2-2i+5i+5i^2\\\\&=-2+3i-5=-7+3i.\\end{aligned}\\]</div><br><br><div style=\"display:inline-block;border:2px solid #00D5FF;padding:8px 14px;border-radius:8px;\"><strong>Answer</strong> &nbsp; \\( -7+3i \\)</div>"
  },
  {
    "type": "math_show",
    "q": "Let \\( z_1 = 3 + i \\) and \\( z_2 = 1 - i \\). Find \\( \\dfrac{z_1}{z_2} \\) in the form \\( x + yi \\).",
    "c": "<strong>Solution</strong><br><br><div style=\"overflow-x:auto;\">\\[\\begin{aligned}\\dfrac{z_1}{z_2}&=\\dfrac{(3+i)(1+i)}{(1-i)(1+i)}\\\\&=\\dfrac{3+3i+i+i^2}{2}=\\dfrac{2+4i}{2}\\\\&=1+2i.\\end{aligned}\\]</div><br><br><div style=\"display:inline-block;border:2px solid #00D5FF;padding:8px 14px;border-radius:8px;\"><strong>Answer</strong> &nbsp; \\( 1+2i \\)</div>"
  },
  {
    "type": "math_show",
    "q": "Let \\( z_1 = 7 - i \\) and \\( z_2 = 2 + i \\). Find \\( \\dfrac{z_1}{z_2} \\) in the form \\( x + yi \\).",
    "c": "<strong>Solution</strong><br><br><div style=\"overflow-x:auto;\">\\[\\begin{aligned}\\dfrac{z_1}{z_2}&=\\dfrac{(7-i)(2-i)}{(2+i)(2-i)}\\\\&=\\dfrac{14-7i-2i+i^2}{5}=\\dfrac{13-9i}{5}\\\\&=\\dfrac{13}{5}-\\dfrac{9}{5}i.\\end{aligned}\\]</div><br><br><div style=\"display:inline-block;border:2px solid #00D5FF;padding:8px 14px;border-radius:8px;\"><strong>Answer</strong> &nbsp; \\( \\dfrac{13}{5}-\\dfrac{9}{5}i \\)</div>"
  },
  {
    "type": "math_show",
    "q": "Let \\( z = 3 + 2i \\). Find \\( \\dfrac{z}{\\bar{z}} \\) in the form \\( x + yi \\).",
    "c": "<strong>Solution</strong><br><br><div style=\"overflow-x:auto;\">\\[\\begin{aligned}\\dfrac{z}{\\bar{z}}&=\\dfrac{(3+2i)(3+2i)}{(3-2i)(3+2i)}\\\\&=\\dfrac{9+12i+4i^2}{13}=\\dfrac{5+12i}{13}\\\\&=\\dfrac{5}{13}+\\dfrac{12}{13}i.\\end{aligned}\\]</div><br><br><div style=\"display:inline-block;border:2px solid #00D5FF;padding:8px 14px;border-radius:8px;\"><strong>Answer</strong> &nbsp; \\( \\dfrac{5}{13}+\\dfrac{12}{13}i \\)</div>"
  },
  {
    "type": "math_show",
    "q": "Solve the equation \\( 3z - 2i = 5 + 4i \\) for \\( z \\).",
    "c": "<strong>Solution</strong><br><br><div style=\"overflow-x:auto;\">\\[\\begin{aligned}3z&=5+6i\\\\z&=\\dfrac{5}{3}+2i.\\end{aligned}\\]</div><br><br><div style=\"display:inline-block;border:2px solid #00D5FF;padding:8px 14px;border-radius:8px;\"><strong>Answer</strong> &nbsp; \\( \\dfrac{5}{3}+2i \\)</div>"
  },
  {
    "type": "math_show",
    "q": "Solve the equation \\( iz = 2 + 3i \\) for \\( z \\).",
    "c": "<strong>Solution</strong><br><br>Multiply both sides by \\( -i \\):<br><div style=\"overflow-x:auto;\">\\[\\begin{aligned}z&=-i(2+3i)=-2i-3i^2=3-2i.\\end{aligned}\\]</div><br><br><div style=\"display:inline-block;border:2px solid #00D5FF;padding:8px 14px;border-radius:8px;\"><strong>Answer</strong> &nbsp; \\( 3-2i \\)</div>"
  },
  {
    "type": "math_show",
    "q": "Solve the equation \\( z + 3\\bar{z} = 4 + 2i \\) for \\( z \\).",
    "c": "<strong>Solution</strong><br><br>Let \\( z = x + yi \\), so \\( \\bar{z} = x - yi \\).<br><div style=\"overflow-x:auto;\">\\[\\begin{aligned}(x+yi)+3(x-yi)&=4+2i\\\\4x-2yi&=4+2i.\\end{aligned}\\]</div><br>Equating real and imaginary parts,<br><div style=\"overflow-x:auto;\">\\[4x=4\\implies x=1,\\qquad -2y=2\\implies y=-1.\\]</div><br>Hence \\( z = 1 - i \\).<br><br><div style=\"display:inline-block;border:2px solid #00D5FF;padding:8px 14px;border-radius:8px;\"><strong>Answer</strong> &nbsp; \\( 1-i \\)</div>"
  },
  {
    "type": "math_show",
    "q": "Solve the equation \\( (2 - i)z = 4 + 3i \\) for \\( z \\).",
    "c": "<strong>Solution</strong><br><br><div style=\"overflow-x:auto;\">\\[\\begin{aligned}z&=\\dfrac{(4+3i)(2+i)}{(2-i)(2+i)}\\\\&=\\dfrac{8+4i+6i+3i^2}{5}=\\dfrac{5+10i}{5}\\\\&=1+2i.\\end{aligned}\\]</div><br><br><div style=\"display:inline-block;border:2px solid #00D5FF;padding:8px 14px;border-radius:8px;\"><strong>Answer</strong> &nbsp; \\( 1+2i \\)</div>"
  },
  {
    "type": "math_show",
    "q": "Solve the equation \\( iz + 2\\bar{z} = 5 + 4i \\) for \\( z \\).",
    "c": "<strong>Solution</strong><br><br>Let \\( z = x + yi \\). Then<br><div style=\"overflow-x:auto;\">\\[\\begin{aligned}i(x+yi)+2(x-yi)&=5+4i\\\\ix+yi^2+2x-2yi&=5+4i\\\\(2x-y)+(x-2y)i&=5+4i.\\end{aligned}\\]</div><br><div style=\"overflow-x:auto;\">\\[2x-y=5,\\qquad x-2y=4.\\]</div><br>From the second equation, \\( x = 4 + 2y \\). Substitute:<br><div style=\"overflow-x:auto;\">\\[2(4+2y)-y=5\\implies 8+4y-y=5\\implies 3y=-3\\implies y=-1.\\]</div><br><div style=\"overflow-x:auto;\">\\[x=4-2=2.\\]</div><br>Hence \\( z = 2 - i \\).<br><br><div style=\"display:inline-block;border:2px solid #00D5FF;padding:8px 14px;border-radius:8px;\"><strong>Answer</strong> &nbsp; \\( 2-i \\)</div>"
  },
  {
    "type": "math_show",
    "q": "Let \\( z_1 = (3,\\, -2) \\) and \\( z_2 = (1,\\, 4) \\). Find \\( z_1 z_2 \\) in ordered-pair form.",
    "c": "<strong>Solution</strong><br><br>The product of ordered pairs is \\( (x_1,y_1)(x_2,y_2)=(x_1 x_2-y_1 y_2,\\, x_1 y_2+y_1 x_2) \\).<br><div style=\"overflow-x:auto;\">\\[\\begin{aligned}(3,-2)(1,4)&=(3\\cdot 1-(-2)\\cdot 4,\\; 3\\cdot 4+(-2)\\cdot 1)\\\\&=(3+8,\\, 12-2)=(11,\\, 10).\\end{aligned}\\]</div><br><br><div style=\"display:inline-block;border:2px solid #00D5FF;padding:8px 14px;border-radius:8px;\"><strong>Answer</strong> &nbsp; \\( (11,\\, 10) \\)</div>"
  },
  {
    "type": "math_show",
    "q": "Let \\( z_1 = (2,\\, 1) \\) and \\( z_2 = (-1,\\, 3) \\). Find \\( z_1 z_2 \\) in ordered-pair form.",
    "c": "<strong>Solution</strong><br><br><div style=\"overflow-x:auto;\">\\[\\begin{aligned}(2,1)(-1,3)&=(2\\cdot(-1)-1\\cdot 3,\\; 2\\cdot 3+1\\cdot(-1))\\\\&=(-2-3,\\, 6-1)=(-5,\\, 5).\\end{aligned}\\]</div><br><br><div style=\"display:inline-block;border:2px solid #00D5FF;padding:8px 14px;border-radius:8px;\"><strong>Answer</strong> &nbsp; \\( (-5,\\, 5) \\)</div>"
  },
  {
    "type": "math_show",
    "q": "Let \\( z_1 = (4,\\, 2) \\) and \\( z_2 = (1,\\, -1) \\). Find \\( \\dfrac{z_1}{z_2} \\) in ordered-pair form.",
    "c": "<strong>Solution</strong><br><br>Write \\( z_1 = 4+2i \\) and \\( z_2 = 1-i \\).<br><div style=\"overflow-x:auto;\">\\[\\begin{aligned}\\dfrac{4+2i}{1-i}&=\\dfrac{(4+2i)(1+i)}{2}\\\\&=\\dfrac{4+4i+2i+2i^2}{2}=\\dfrac{2+6i}{2}\\\\&=1+3i.\\end{aligned}\\]</div><br>So the ordered pair is \\( (1,\\, 3) \\).<br><br><div style=\"display:inline-block;border:2px solid #00D5FF;padding:8px 14px;border-radius:8px;\"><strong>Answer</strong> &nbsp; \\( (1,\\, 3) \\)</div>"
  },
  {
    "type": "math_show",
    "q": "Find the trigonometric form of \\( z = 2\\sqrt{3} - 2i \\) with \\( -\\pi < \\theta \\le \\pi \\).<br><br><svg viewBox=\"0 0 280 280\" xmlns=\"http://www.w3.org/2000/svg\"><line x1=\"18\" y1=\"140.0\" x2=\"262\" y2=\"140.0\" stroke=\"#FFFFFF\" stroke-width=\"2\"/><line x1=\"140.0\" y1=\"18\" x2=\"140.0\" y2=\"262\" stroke=\"#FFFFFF\" stroke-width=\"2\"/><polygon points=\"262,140.0 252,134.0 252,146.0\" fill=\"#FFFFFF\"/><polygon points=\"140.0,18 134.0,28 146.0,28\" fill=\"#FFFFFF\"/><text x=\"258\" y=\"128.0\" fill=\"#FFFFFF\" font-size=\"13\">Re</text><text x=\"148.0\" y=\"26\" fill=\"#FFFFFF\" font-size=\"13\">Im</text><line x1=\"140.0\" y1=\"140.0\" x2=\"240.0\" y2=\"197.7\" stroke=\"#00EDFF\" stroke-width=\"2.5\"/><circle cx=\"240.0\" cy=\"197.7\" r=\"5\" fill=\"#00EDFF\"/><text x=\"250.0\" y=\"187.7\" fill=\"#00EDFF\" font-size=\"14\">z</text></svg>",
    "c": "<strong>Solution</strong><br><br><div style=\"overflow-x:auto;\">\\[r=\\sqrt{(2\\sqrt{3})^2+(-2)^2}=\\sqrt{12+4}=4\\]</div><br><div style=\"overflow-x:auto;\">\\[\\cos\\theta=\\dfrac{\\sqrt{3}}{2},\\quad\\sin\\theta=-\\dfrac12\\implies\\theta=-\\dfrac{\\pi}{6}\\]</div><br><div style=\"overflow-x:auto;\">\\[z=4\\left(\\cos\\left(-\\dfrac{\\pi}{6}\\right)+i\\sin\\left(-\\dfrac{\\pi}{6}\\right)\\right)\\]</div><br><br><div style=\"display:inline-block;border:2px solid #00D5FF;padding:8px 14px;border-radius:8px;\"><strong>Answer</strong> &nbsp; \\( 4\\left(\\cos\\left(-\\dfrac{\\pi}{6}\\right)+i\\sin\\left(-\\dfrac{\\pi}{6}\\right)\\right) \\)</div>"
  },
  {
    "type": "math_show",
    "q": "Find the trigonometric form of \\( z = -4 + 4i \\) with \\( -\\pi < \\theta \\le \\pi \\).<br><br><svg viewBox=\"0 0 280 280\" xmlns=\"http://www.w3.org/2000/svg\"><line x1=\"18\" y1=\"140.0\" x2=\"262\" y2=\"140.0\" stroke=\"#FFFFFF\" stroke-width=\"2\"/><line x1=\"140.0\" y1=\"18\" x2=\"140.0\" y2=\"262\" stroke=\"#FFFFFF\" stroke-width=\"2\"/><polygon points=\"262,140.0 252,134.0 252,146.0\" fill=\"#FFFFFF\"/><polygon points=\"140.0,18 134.0,28 146.0,28\" fill=\"#FFFFFF\"/><text x=\"258\" y=\"128.0\" fill=\"#FFFFFF\" font-size=\"13\">Re</text><text x=\"148.0\" y=\"26\" fill=\"#FFFFFF\" font-size=\"13\">Im</text><line x1=\"140.0\" y1=\"140.0\" x2=\"40.0\" y2=\"40.0\" stroke=\"#00EDFF\" stroke-width=\"2.5\"/><circle cx=\"40.0\" cy=\"40.0\" r=\"5\" fill=\"#00EDFF\"/><text x=\"18.0\" y=\"30.0\" fill=\"#00EDFF\" font-size=\"14\">z</text></svg>",
    "c": "<strong>Solution</strong><br><br><div style=\"overflow-x:auto;\">\\[r=\\sqrt{16+16}=4\\sqrt{2}\\]</div><br><div style=\"overflow-x:auto;\">\\[\\cos\\theta=-\\dfrac{1}{\\sqrt{2}},\\quad\\sin\\theta=\\dfrac{1}{\\sqrt{2}}\\implies\\theta=\\dfrac{3\\pi}{4}\\]</div><br><div style=\"overflow-x:auto;\">\\[z=4\\sqrt{2}\\left(\\cos\\dfrac{3\\pi}{4}+i\\sin\\dfrac{3\\pi}{4}\\right)\\]</div><br><br><div style=\"display:inline-block;border:2px solid #00D5FF;padding:8px 14px;border-radius:8px;\"><strong>Answer</strong> &nbsp; \\( 4\\sqrt{2}\\left(\\cos\\dfrac{3\\pi}{4}+i\\sin\\dfrac{3\\pi}{4}\\right) \\)</div>"
  },
  {
    "type": "math_show",
    "q": "Find the trigonometric form of \\( z = -6i \\) with \\( -\\pi < \\theta \\le \\pi \\).<br><br><svg viewBox=\"0 0 280 280\" xmlns=\"http://www.w3.org/2000/svg\"><line x1=\"18\" y1=\"140.0\" x2=\"262\" y2=\"140.0\" stroke=\"#FFFFFF\" stroke-width=\"2\"/><line x1=\"140.0\" y1=\"18\" x2=\"140.0\" y2=\"262\" stroke=\"#FFFFFF\" stroke-width=\"2\"/><polygon points=\"262,140.0 252,134.0 252,146.0\" fill=\"#FFFFFF\"/><polygon points=\"140.0,18 134.0,28 146.0,28\" fill=\"#FFFFFF\"/><text x=\"258\" y=\"128.0\" fill=\"#FFFFFF\" font-size=\"13\">Re</text><text x=\"148.0\" y=\"26\" fill=\"#FFFFFF\" font-size=\"13\">Im</text><line x1=\"140.0\" y1=\"140.0\" x2=\"140.0\" y2=\"240.0\" stroke=\"#00EDFF\" stroke-width=\"2.5\"/><circle cx=\"140.0\" cy=\"240.0\" r=\"5\" fill=\"#00EDFF\"/><text x=\"150.0\" y=\"230.0\" fill=\"#00EDFF\" font-size=\"14\">z</text></svg>",
    "c": "<strong>Solution</strong><br><br><div style=\"overflow-x:auto;\">\\[r=6,\\qquad\\cos\\theta=0,\\quad\\sin\\theta=-1\\]</div><br>The point lies on the negative imaginary axis, so \\( \\theta = -\\dfrac{\\pi}{2} \\) (not \\( \\dfrac{3\\pi}{2} \\)).<br><div style=\"overflow-x:auto;\">\\[z=6\\left(\\cos\\left(-\\dfrac{\\pi}{2}\\right)+i\\sin\\left(-\\dfrac{\\pi}{2}\\right)\\right)\\]</div><br><br><div style=\"display:inline-block;border:2px solid #00D5FF;padding:8px 14px;border-radius:8px;\"><strong>Answer</strong> &nbsp; \\( 6\\left(\\cos\\left(-\\dfrac{\\pi}{2}\\right)+i\\sin\\left(-\\dfrac{\\pi}{2}\\right)\\right) \\)</div>"
  },
  {
    "type": "math_show",
    "q": "Find the trigonometric form of \\( z = \\sqrt{2} + \\sqrt{6}\\, i \\) with \\( -\\pi < \\theta \\le \\pi \\).",
    "c": "<strong>Solution</strong><br><br><div style=\"overflow-x:auto;\">\\[r=\\sqrt{2+6}=2\\sqrt{2}\\]</div><br><div style=\"overflow-x:auto;\">\\[\\cos\\theta=\\dfrac{\\sqrt{2}}{2\\sqrt{2}}=\\dfrac12,\\quad\\sin\\theta=\\dfrac{\\sqrt{6}}{2\\sqrt{2}}=\\dfrac{\\sqrt{3}}{2}\\]</div><br><div style=\"overflow-x:auto;\">\\[\\theta=\\dfrac{\\pi}{3}\\]</div><br><div style=\"overflow-x:auto;\">\\[z=2\\sqrt{2}\\left(\\cos\\dfrac{\\pi}{3}+i\\sin\\dfrac{\\pi}{3}\\right)\\]</div><br><br><div style=\"display:inline-block;border:2px solid #00D5FF;padding:8px 14px;border-radius:8px;\"><strong>Answer</strong> &nbsp; \\( 2\\sqrt{2}\\left(\\cos\\dfrac{\\pi}{3}+i\\sin\\dfrac{\\pi}{3}\\right) \\)</div>"
  },
  {
    "type": "math_show",
    "q": "Let \\( z_1 = 3\\left(\\cos\\dfrac{\\pi}{4}+i\\sin\\dfrac{\\pi}{4}\\right) \\) and \\( z_2 = 2\\left(\\cos\\dfrac{\\pi}{12}+i\\sin\\dfrac{\\pi}{12}\\right) \\). Find \\( z_1 z_2 \\) in trigonometric form.",
    "c": "<strong>Solution</strong><br><br><div style=\"overflow-x:auto;\">\\[\\begin{aligned}z_1 z_2&=6\\left(\\cos\\left(\\dfrac{\\pi}{4}+\\dfrac{\\pi}{12}\\right)+i\\sin\\left(\\dfrac{\\pi}{4}+\\dfrac{\\pi}{12}\\right)\\right)\\\\&=6\\left(\\cos\\dfrac{\\pi}{3}+i\\sin\\dfrac{\\pi}{3}\\right).\\end{aligned}\\]</div><br><br><div style=\"display:inline-block;border:2px solid #00D5FF;padding:8px 14px;border-radius:8px;\"><strong>Answer</strong> &nbsp; \\( 6\\left(\\cos\\dfrac{\\pi}{3}+i\\sin\\dfrac{\\pi}{3}\\right) \\)</div>"
  },
  {
    "type": "math_show",
    "q": "Let \\( z_1 = 6\\left(\\cos\\dfrac{5\\pi}{6}+i\\sin\\dfrac{5\\pi}{6}\\right) \\) and \\( z_2 = 2\\left(\\cos\\dfrac{\\pi}{3}+i\\sin\\dfrac{\\pi}{3}\\right) \\). Find \\( \\dfrac{z_1}{z_2} \\) in trigonometric form.",
    "c": "<strong>Solution</strong><br><br><div style=\"overflow-x:auto;\">\\[\\begin{aligned}\\dfrac{z_1}{z_2}&=3\\left(\\cos\\left(\\dfrac{5\\pi}{6}-\\dfrac{\\pi}{3}\\right)+i\\sin\\left(\\dfrac{5\\pi}{6}-\\dfrac{\\pi}{3}\\right)\\right)\\\\&=3\\left(\\cos\\dfrac{\\pi}{2}+i\\sin\\dfrac{\\pi}{2}\\right).\\end{aligned}\\]</div><br><br><div style=\"display:inline-block;border:2px solid #00D5FF;padding:8px 14px;border-radius:8px;\"><strong>Answer</strong> &nbsp; \\( 3\\left(\\cos\\dfrac{\\pi}{2}+i\\sin\\dfrac{\\pi}{2}\\right) \\)</div>"
  },
  {
    "type": "math_show",
    "q": "Given \\( z_1 = \\sqrt{3} + i \\) and \\( z_2 = 1 + i \\), find \\( \\dfrac{z_1}{z_2} \\) using trigonometric forms.",
